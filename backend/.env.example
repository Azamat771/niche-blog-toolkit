# --- LLM (DeepSeek, OpenAI-compatible) ---
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# --- Web search for trends (Tavily) ---
# Get a key at https://app.tavily.com (1000 free searches/month)
# Without this, agents work on season+memory only.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# --- Niche config (which JSON the backend reads on start) ---
# Path is resolved relative to backend/. Examples:
#   ../config/default.niche.json
#   ../examples/plants/niche.json
#   ../examples/fitness/niche.json
NICHE_CONFIG=../config/default.niche.json

# --- Network ---
PORT=3007
# Origin allowed for CORS. Use "*" while testing locally, set your domain in prod.
ALLOWED_ORIGIN=*

# --- Anti-abuse ---
# Lightweight token also embedded in the frontend (not a real secret, blocks naive curl).
SHARED_TOKEN=change-me-in-prod
# Daily LLM spend cap in USD. Service returns HTTP 429 after this.
DAILY_CAP_USD=0.50

# --- DeepSeek pricing (USD per 1M tokens, used for cap accounting) ---
PRICE_IN=0.14
PRICE_OUT=0.28
